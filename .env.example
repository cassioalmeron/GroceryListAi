# Docker Compose Environment Variables
# Copy this file to .env and update the values before running docker-compose up

# ============================================
# Frontend Configuration
# ============================================

# API URL for the frontend (used at build time)
# For Docker Compose: http://localhost:5002 (maps to host)
# For production: your actual backend URL
VITE_API_URL=http://localhost:5002

# ============================================
# Backend Configuration
# ============================================

# AI Provider Configuration
# Options: "chatgpt" or "ollama"
LLM=chatgpt

# Model to use
# For ChatGPT: gpt-4o-mini, gpt-4o, gpt-4-turbo, etc.
# For Ollama: a tool-calling-capable model, e.g. llama3.1, qwen2.5
MODEL=gpt-4o-mini

# OpenAI API Key (REQUIRED if LLM=chatgpt)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# Options: "Sqlite" or "Postgres"
DATABASE_PROVIDER=Postgres

# Connection string, shape depends on DATABASE_PROVIDER:
# Postgres: Host=hostname;Port=5432;Database=grocery_list;Username=user;Password=password
# Sqlite:   Data Source=/app/data/grocery_list.db
CONNECTION_STRING=Host=hostname;Port=5432;Database=grocery_list;Username=user;Password=password

# Allowed origins for the frontend to call the backend directly (comma-separated, no spaces).
# For Docker Compose: should match the host/port the browser loads the frontend from.
CORS_ORIGINS=http://localhost:82

# API Server Configuration
API_PORT=5002

# Frontend Server Configuration
FRONTEND_PORT=82
